---
import BaseLayout from '../layouts/BaseLayout.astro';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
---
<BaseLayout
  title="ExampleRealty – Nekretnine u Srbiji"
  description="Pronađite stan, kuću ili poslovni prostor u Beogradu, Novom Sadu, Nišu i širom Srbije."
  canonical={`${site}/`}
>
  <section style="text-align:center; padding: 3rem 0;">
    <h1 style="font-size:2.2rem; margin-bottom:1rem;">Dobrodošli na ExampleRealty</h1>
    <p style="color:#555; max-width:600px; margin:0 auto 2rem;">
      Dummy sajt za testiranje tehničke implementacije location-based redirecta u Astro middleware-u.
    </p>
    <a href="/nekretnine" style="background:#1a3c5e;color:#fff;padding:.75rem 1.75rem;border-radius:6px;text-decoration:none;font-weight:600;">
      Pregledaj nekretnine →
    </a>
  </section>

  <section style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:1.5rem; margin-top:2rem;">
    {[
      { city: 'Beograd', slug: 'beograd', tagline: '1,240 oglasa' },
      { city: 'Novi Sad', slug: 'novi-sad', tagline: '580 oglasa' },
      { city: 'Niš',     slug: 'nis',      tagline: '310 oglasa' },
    ].map(({ city, slug, tagline }) => (
      <a href={`/nekretnine/${slug}`} style="display:block;background:#fff;border:1px solid #e5e5e5;border-radius:8px;padding:1.5rem;text-decoration:none;color:inherit;">
        <h2 style="margin-bottom:.4rem;">{city}</h2>
        <p style="color:#666;font-size:.9rem;">{tagline}</p>
      </a>
    ))}
  </section>
</BaseLayout>
