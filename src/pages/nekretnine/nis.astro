---
import BaseLayout from '../../layouts/BaseLayout.astro';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';

const listings = [
  { id: 1, title: 'Stan u centru Niša',             type: 'Stan',  rooms: '2.0', area: 58,  price: 85_000, img: '🏢' },
  { id: 2, title: 'Kuća na Bulevaru Nemanjića',     type: 'Kuća',  rooms: '4.0', area: 140, price: 175_000, img: '🏠' },
  { id: 3, title: 'Jednosoban stan Medijana',       type: 'Stan',  rooms: '1.5', area: 38,  price: 55_000, img: '🏗️' },
];
---
<BaseLayout
  title="Nekretnine Niš – Stanovi i Kuće | ExampleRealty"
  description="Pronađite stan ili kuću u Nišu. 310 oglasa – centar, Medijana, Bulevar Nemanjića."
  canonical={`${site}/nekretnine/nis`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Početna",    "item": `${site}/` },
      { "@type": "ListItem", "position": 2, "name": "Nekretnine", "item": `${site}/nekretnine` },
      { "@type": "ListItem", "position": 3, "name": "Niš",        "item": `${site}/nekretnine/nis` },
    ],
  })} />

  <nav style="font-size:.85rem;color:#888;margin-bottom:1.5rem;">
    <a href="/">Početna</a> &rsaquo;
    <a href="/nekretnine">Nekretnine</a> &rsaquo;
    <strong>Niš</strong>
  </nav>

  <h1 style="font-size:1.9rem;margin-bottom:.4rem;">Nekretnine u Nišu</h1>
  <p style="color:#555;margin-bottom:2rem;">310 aktivnih oglasa – stanovi i kuće</p>

  <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap:1.25rem;">
    {listings.map((l) => (
      <article style="background:#fff;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;">
        <div style="background:#e8fef0;height:120px;display:flex;align-items:center;justify-content:center;font-size:3rem;">{l.img}</div>
        <div style="padding:1rem;">
          <span style="font-size:.75rem;background:#1a7a42;color:#fff;padding:.2rem .6rem;border-radius:20px;">{l.type}</span>
          <h2 style="font-size:1rem;margin:.5rem 0 .3rem;">{l.title}</h2>
          <p style="color:#666;font-size:.85rem;">📐 {l.area} m²&nbsp;&nbsp;🛏 {l.rooms} sobe</p>
          <p style="font-weight:700;font-size:1.1rem;margin-top:.5rem;color:#1a7a42;">€{l.price.toLocaleString('sr-RS')}</p>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
