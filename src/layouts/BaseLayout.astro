---
export interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="sr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical: each page points to itself – no duplicate-content penalty -->
    <link rel="canonical" href={canonical} />

    <!-- Only noindex pages that should never rank (e.g. redirect landing) -->
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; color: #1a1a1a; background: #f9f9f9; }
      header { background: #1a3c5e; color: #fff; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
      header a { color: #fff; text-decoration: none; font-weight: 600; }
      nav a { margin-left: 1.5rem; color: #cce0f5; font-size: 0.95rem; }
      main { max-width: 1100px; margin: 2rem auto; padding: 0 1.5rem; }
      footer { text-align: center; padding: 2rem; color: #888; font-size: 0.85rem; border-top: 1px solid #e5e5e5; margin-top: 3rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/">ExampleRealty</a>
      <nav>
        <a href="/nekretnine">Sve nekretnine</a>
        <a href="/nekretnine/beograd">Beograd</a>
        <a href="/nekretnine/novi-sad">Novi Sad</a>
        <a href="/nekretnine/nis">Niš</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      &copy; {new Date().getFullYear()} ExampleRealty – Dummy data, testing only
    </footer>
  </body>
</html>
